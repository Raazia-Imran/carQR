{
  "name": "carqr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx --env-file=.env scripts/migrate.ts",
    "db:local": "node --import tsx --env-file=.env scripts/local-db.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "worker": "node --import tsx --env-file=.env scripts/worker.ts",
    "admin:bootstrap": "node --import tsx --env-file=.env scripts/bootstrap-admin.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "retention": "node --import tsx --env-file=.env scripts/retention.ts"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
