{
  "name": "qr-car",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file=.env --import tsx apps/worker/main.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-cli.ts",
    "local:setup": "node --import tsx scripts/local-setup.ts",
    "local:db": "node --import tsx scripts/local-db.ts",
    "admin:grant": "node --env-file=.env --import tsx scripts/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write app packages apps scripts tests next.config.ts",
    "format:check": "prettier --check app packages apps scripts tests next.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "jose": "6.2.12",
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
