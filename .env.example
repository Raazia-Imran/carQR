# Run npm run local:setup to generate independent random local secrets.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://qrcar:LOCAL_PASSWORD@localhost:55432/qrcar
PROVIDER_MODE=simulation
AUTH_MODE=simulation
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=
SESSION_SECRET=
# Live identity: Supabase phone auth, CAPTCHA and SMS configured in that project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Live WhatsApp: approved template with two text variables (reason, reference).
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en
# Contracted supplier gateway; implement docs/PROVIDERS.md contract.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_WEBHOOK_SECRET=
DAILY_MESSAGE_LIMIT=500
MESSAGING_ENABLED=true
# Only enable when the trusted ingress overwrites this header.
TRUST_PROXY=false
# In live mode, configure the same Turnstile widget in Supabase Auth CAPTCHA settings.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# For Docker Compose local PostgreSQL, use the same password as DATABASE_URL.
POSTGRES_PASSWORD=
