# Run npm run setup:local to generate development keys. Never commit .env.
APP_URL=http://localhost:3000
APP_MODE=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/carqr
DATA_KEY=
HASH_KEY=
# local | live. Live refuses the local transport.
NOTIFICATION_PROVIDER=local
# Official Meta Cloud API (live WhatsApp); opt-in/approved template required.
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_TEMPLATE_NAME=vehicle_alert
META_TEMPLATE_LANGUAGE=en
# Contracted SMS HTTPS adapter: see docs/IMPLEMENTATION.md; no default vendor.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_WEBHOOK_SECRET=
TRUST_PROXY=false
SMS_DELAY_SECONDS=90
BACKUP_DELAY_SECONDS=180
INCIDENT_TTL_SECONDS=600
DAILY_SMS_LIMIT=100
